generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 이메일과 비밀번호로 로그인하는 회원. 포트폴리오는 이 사용자에게만 보인다.
model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String?
  passwordHash String
  /// user 또는 admin. admin은 이메일 대신 ID "admin"으로 로그인한다.
  role         String      @default("user")
  /// 임시 비밀번호로 만든 계정은 첫 로그인 뒤 비밀번호를 바꿔야 한다.
  mustChangePassword Boolean @default(false)
  /// income 생활비 우선, balance 균형, growth 성장 여유. 목표 비중은 그대로 두고 국면 설명만 바꾼다.
  investorStyle String @default("income")
  /// 마지막으로 로그인한 시각. 로그아웃해도 남는다.
  lastLoginAt  DateTime?
  portfolios   Portfolio[]
  sessions     Session[]
  createdAt    DateTime    @default(now())
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Portfolio {
  id           String              @id @default(cuid())
  userId       String?
  user         User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String              @default("내 포트폴리오")
  baseCurrency String              @default("KRW")
  phase        String              @default("B1")
  phaseSource  String              @default("manual")
  usdKrw       Float               @default(1000)
  /// auto면 오늘 시세로 갱신한다. manual이면 입력값이나 예시 1,000원을 유지한다.
  fxSource     String              @default("auto")
  fxUpdatedAt  DateTime            @default(now())
  rateMemo     String?
  yieldMemo    String?
  holdings     Holding[]
  incomes      IncomeEvent[]
  returnIncomes ReturnIncome[]
  snapshots    RebalanceSnapshot[]
  valuations   Valuation[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId])
}

model Holding {
  id             String    @id @default(cuid())
  portfolioId    String
  portfolio      Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  ticker         String
  name           String    @default("")
  sleeve         String
  altKind        String?
  bondDuration   String?
  isCoveredCall  Boolean   @default(false)
  quantity       Float
  currency       String
  /// 매입 평균단가. 없으면 현재가로 원금을 본다.
  avgPrice       Float?
  manualPrice    Float?
  /// auto면 오늘 종가로 갱신한다. manual이면 입력한 가격을 유지한다. 현금은 항상 1이다.
  priceSource    String    @default("auto")
  priceUpdatedAt DateTime  @default(now())

  @@unique([portfolioId, ticker])
}

model IncomeEvent {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  date        DateTime
  ticker      String
  amount      Float
  currency    String
}

/// 배당, 이자, 판매 수익. 발생한 날짜가 속한 구간의 수익률에 더한다.
model ReturnIncome {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  /// 서울 날짜. YYYY-MM-DD
  date        String
  /// dividend, interest, sale
  kind        String
  /// 입력 통화. KRW 또는 USD. 예전 기록은 KRW.
  currency    String    @default("KRW")
  /// 입력한 금액. USD면 달러, KRW면 원. 예전 기록은 amountKrw와 같다.
  amount      Float     @default(0)
  /// 수익률에 더하는 원화. 달러는 지금 저장된 환율을 곱한 값이다.
  amountKrw   Float
  note        String    @default("")
  createdAt   DateTime  @default(now())

  @@index([portfolioId, date])
}

model RebalanceSnapshot {
  id           String    @id @default(cuid())
  portfolioId  String
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  yearMonth    String
  /// 확정 중일 때만 연월. 해제하면 null. SQLite는 null 중복을 허용한다.
  activeKey    String?
  phase        String
  phaseSource  String
  totalKrw     Float
  sleevesJson  String
  targetsJson  String
  linesJson    String
  /// 기록 당시 수량(before)과 실행서대로 조정한 수량(after). 이후 가격으로 두 수익률을 비교한다.
  booksJson    String    @default("")
  incomeKrw    Float
  confirmedAt  DateTime  @default(now())
  releasedAt   DateTime?

  @@unique([portfolioId, activeKey])
}

/// 서울 날짜별 평가액. 앱을 연 날의 총자산과, 예전 실행 기록의 평가액을 남긴다.
model Valuation {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  date        String
  totalKrw    Float
  /// 직전 기록 이후 수량이 바뀌어 늘거나 준 금액. 종목 추가·삭제·입출금은 수익이 아니다.
  flowKrw     Float     @default(0)
  /// 그날 마지막 보유 수량과 가격. 다음 기록의 유입액을 계산하는 기준이다.
  positionsJson String  @default("")
  updatedAt   DateTime  @updatedAt

  @@unique([portfolioId, date])
  @@index([portfolioId, date])
}

/// 종목 종가. 서울 날짜 기준으로 하루 한 번 채운다.
model PriceCache {
  id       String @id @default(cuid())
  ticker   String
  date     String
  currency String
  close    Float

  @@unique([ticker, date])
}

model FxRate {
  id     String @id @default(cuid())
  pair   String
  date   String
  rate   Float
  source String

  @@unique([pair, date])
}

model MacroSeries {
  id       String @id @default(cuid())
  seriesId String
  date     String
  value    Float

  @@unique([seriesId, date])
}

/// 관리자가 정한 국면과 국면별 목표 비중. 모든 사용자에게 같이 적용된다. 행은 id "global" 하나뿐이다.
model PhaseSetting {
  id          String   @id @default("global")
  phase       String   @default("B1")
  /// 국면별 비중 덮어쓰기. 비어 있는 국면은 config.ts의 기본표를 쓴다.
  weightsJson String   @default("")
  /// 국면별 "왜 이 국면인가요" 설명. 비어 있는 국면은 기본 설명을 쓴다.
  whyJson     String   @default("")
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

/// 관리자가 고른 분류별 추천 종목. 모든 사용자의 추천 탭에 같이 보인다. 행은 id "global" 하나뿐이다.
model RecommendationSetting {
  id          String   @id @default("global")
  /// { 분류: [{ ticker, name, note }] }
  itemsJson   String   @default("")
  /// 예전 단일 리포트. 처음 읽을 때 AnalysisReport로 옮긴 뒤 비운다.
  reportTitle String   @default("")
  reportBody  String   @default("")
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

/// 관리자가 날짜별로 남긴 분석 리포트. 같은 날짜에 여러 개를 둘 수 있으며 모든 사용자에게 같이 보인다.
model AnalysisReport {
  id        String   @id @default(cuid())
  /// 서울 기준 YYYY-MM-DD. 하루에도 여러 리포트를 둘 수 있다.
  date      String
  title     String   @default("")
  body      String   @default("")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date, createdAt])
}

model PhaseDiagnosis {
  id         String  @id @default(cuid())
  date       String  @unique
  autoPhase  String?
  ruleId     Int?
  inputsJson String
  summary    String
}
