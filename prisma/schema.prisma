generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 이메일과 비밀번호로 로그인하는 회원. 포트폴리오는 이 사용자에게만 보인다.
model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String?
  passwordHash String
  /// user 또는 admin. admin은 이메일 대신 ID "admin"으로 로그인한다.
  role         String      @default("user")
  /// 임시 비밀번호로 만든 계정은 첫 로그인 뒤 비밀번호를 바꿔야 한다.
  mustChangePassword Boolean @default(false)
  /// income 생활비 우선, balance 균형, growth 성장 여유. 목표 비중은 그대로 두고 국면 설명만 바꾼다.
  investorStyle String @default("income")
  /// 마지막으로 로그인한 시각. 로그아웃해도 남는다.
  lastLoginAt  DateTime?
  /// 화면을 실제로 연 시각. 5분에 한 번만 갱신한다.
  lastSeenAt   DateTime?
  /// 관리자 승인. 꺼져 있으면 가입은 되어 있어도 로그인할 수 없다. 새 회원은 꺼짐.
  approved     Boolean     @default(false)
  /// Ai-추천 종목 모델. claude 또는 spark. 사용자가 설정에서 고른다. spark는 서버의 Qwen이다.
  pickEngine   String      @default("claude")
  /// 목표 비중 모델. claude 또는 spark. 비중 숫자는 국면 표와 우선으로 계산하고, 이 값은 그 계정이 고른 모델이다.
  weightEngine String      @default("claude")
  /// 추천종목 버튼. 꺼져 있으면 실행하지 않는다. 새 회원은 꺼짐.
  pickEnabled  Boolean     @default(false)
  /// Ai-종목추천을 새로 받을 수 있는 횟수. 저장본을 다시 보는 것은 세지 않는다. 기본은 1이다.
  pickLimit    Int         @default(1)
  /// 이미 새로 받은 횟수.
  pickUsed     Int         @default(0)
  /// 추천 상품. etf, mix, stock. 비어 있으면 아직 고르지 않았다.
  pickInstrument String @default("")
  /// 추천 매수. existing, half, fresh.
  pickAddTo    String      @default("")
  /// 익숙한 시장. kr, both, us. 자산군은 바꾸지 않고, 양쪽 상장이 가능한 칸에서만 쓴다.
  pickMarket   String      @default("")
  /// 종목 우선. payout 분배, both 둘 다, price 가격 상승. 비어 있으면 둘 다로 본다.
  pickAim      String      @default("")
  /// 제외 상품. leverage, single. 쉼표로 구분하고, 비어 있으면 제외하지 않는다.
  pickExclude  String      @default("")
  /// 선호 섹터. tech, semi, finance, energy, health, consumer, industrial. 쉼표로 구분하고, 비어 있으면 가리지 않는다.
  pickSectors  String      @default("")
  /// 향후 추진 계획 기간. 1주, 2주, 4주. 종목 추천은 바꾸지 않는다.
  pickPlanWeeks Int        @default(1)
  portfolios   Portfolio[]
  sessions     Session[]
  llmKeys      UserLlmKey[]
  adviceCaches AdviceCache[]
  pickCache    PickCache?
  createdAt    DateTime    @default(now())
}

/// 회원·모델별 마지막 자문. 업데이트 버튼을 누르기 전에는 다시 호출하지 않는다.
model AdviceCache {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 요청한 모델. spark, openai, anthropic, google
  engine    String
  /// 글을 쓴 쪽. spark, openai, anthropic, google, draft
  source    String
  phase     String
  portfolio String
  actions   String
  leave     String
  notice    String?
  updatedAt DateTime @updatedAt

  @@unique([userId, engine])
}

/// 회원이 마지막으로 받은 추천 종목. 다시 받기를 누르기 전에는 지정된 모델을 다시 부르지 않는다.
model PickCache {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// snapshot, items, reason을 담은 JSON. reason은 다시 받기로 지운다.
  body      String
  updatedAt DateTime @updatedAt
}

/// 추천 종목 Claude. 관리자가 저장한 API 키와 워크스페이스. 서버가 켜질 때 이 행을 읽는다. 행은 id "global" 하나뿐이다.
model PickClaudeSetting {
  id          String   @id @default("global")
  /// 관리자가 저장한 Claude API 키.
  cipher      String   @default("")
  last4       String   @default("")
  workspaceId String   @default("")
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

/// 회원이 직접 넣은 상용 모델 키. 평문은 저장하지 않는다.
model UserLlmKey {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// openai, anthropic, google
  provider  String
  cipher    String
  last4     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Portfolio {
  id           String              @id @default(cuid())
  userId       String?
  user         User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String              @default("내 포트폴리오")
  baseCurrency String              @default("KRW")
  phase        String              @default("B1")
  phaseSource  String              @default("manual")
  usdKrw       Float               @default(1000)
  /// auto면 오늘 시세로 갱신한다. manual이면 입력값이나 예시 1,000원을 유지한다.
  fxSource     String              @default("auto")
  fxUpdatedAt  DateTime            @default(now())
  rateMemo     String?
  yieldMemo    String?
  holdings     Holding[]
  incomes      IncomeEvent[]
  returnIncomes ReturnIncome[]
  snapshots    RebalanceSnapshot[]
  valuations   Valuation[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId])
}

model Holding {
  id             String    @id @default(cuid())
  portfolioId    String
  portfolio      Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  ticker         String
  name           String    @default("")
  sleeve         String
  altKind        String?
  bondDuration   String?
  isCoveredCall  Boolean   @default(false)
  quantity       Float
  currency       String
  /// 매입 평균단가. 없으면 현재가로 원금을 본다.
  avgPrice       Float?
  manualPrice    Float?
  /// auto면 오늘 종가로 갱신한다. manual이면 입력한 가격을 유지한다. 현금은 항상 1이다.
  priceSource    String    @default("auto")
  priceUpdatedAt DateTime  @default(now())

  @@unique([portfolioId, ticker])
}

model IncomeEvent {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  date        DateTime
  ticker      String
  amount      Float
  currency    String
}

/// 배당, 이자, 판매 수익. 발생한 날짜가 속한 구간의 수익률에 더한다.
model ReturnIncome {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  /// 서울 날짜. YYYY-MM-DD
  date        String
  /// dividend, interest, sale
  kind        String
  /// 입력 통화. KRW 또는 USD. 예전 기록은 KRW.
  currency    String    @default("KRW")
  /// 입력한 금액. USD면 달러, KRW면 원. 예전 기록은 amountKrw와 같다.
  amount      Float     @default(0)
  /// 수익률에 더하는 원화. 달러는 지금 저장된 환율을 곱한 값이다.
  amountKrw   Float
  note        String    @default("")
  createdAt   DateTime  @default(now())

  @@index([portfolioId, date])
}

model RebalanceSnapshot {
  id           String    @id @default(cuid())
  portfolioId  String
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  yearMonth    String
  /// 확정 중일 때만 연월. 해제하면 null. SQLite는 null 중복을 허용한다.
  activeKey    String?
  phase        String
  phaseSource  String
  totalKrw     Float
  sleevesJson  String
  targetsJson  String
  linesJson    String
  /// 기록 당시 수량(before)과 실행서대로 조정한 수량(after). 이후 가격으로 두 수익률을 비교한다.
  booksJson    String    @default("")
  incomeKrw    Float
  confirmedAt  DateTime  @default(now())
  releasedAt   DateTime?

  @@unique([portfolioId, activeKey])
}

/// 서울 날짜별 평가액. 앱을 연 날의 총자산과, 예전 실행 기록의 평가액을 남긴다.
model Valuation {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  date        String
  totalKrw    Float
  /// 직전 기록 이후 수량이 바뀌어 늘거나 준 금액. 종목 추가·삭제·입출금은 수익이 아니다.
  flowKrw     Float     @default(0)
  /// 그날 마지막 보유 수량과 가격. 다음 기록의 유입액을 계산하는 기준이다.
  positionsJson String  @default("")
  updatedAt   DateTime  @updatedAt

  @@unique([portfolioId, date])
  @@index([portfolioId, date])
}

/// 종목 종가. 서울 날짜 기준으로 하루 한 번 채운다.
model PriceCache {
  id       String @id @default(cuid())
  ticker   String
  date     String
  currency String
  close    Float

  @@unique([ticker, date])
}

model FxRate {
  id     String @id @default(cuid())
  pair   String
  date   String
  rate   Float
  source String

  @@unique([pair, date])
}

model MacroSeries {
  id       String @id @default(cuid())
  seriesId String
  date     String
  value    Float

  @@unique([seriesId, date])
}

/// 관리자가 정한 국면과 국면별 목표 비중. 모든 사용자에게 같이 적용된다. 행은 id "global" 하나뿐이다.
model PhaseSetting {
  id          String   @id @default("global")
  phase       String   @default("B1")
  /// 국면별 비중 덮어쓰기. 비어 있는 국면은 config.ts의 기본표를 쓴다.
  weightsJson String   @default("")
  /// 국면별 "왜 이 국면인가요" 설명. 비어 있는 국면은 기본 설명을 쓴다.
  whyJson     String   @default("")
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

/// 관리자가 고른 분류별 추천 종목. 모든 사용자의 추천 탭에 같이 보인다. 행은 id "global" 하나뿐이다.
model RecommendationSetting {
  id          String   @id @default("global")
  /// { 분류: [{ ticker, name, note }] }
  itemsJson   String   @default("")
  /// 예전 단일 리포트. 처음 읽을 때 AnalysisReport로 옮긴 뒤 비운다.
  reportTitle String   @default("")
  reportBody  String   @default("")
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

/// 관리자가 날짜별로 남긴 분석 리포트. 같은 날짜에 여러 개를 둘 수 있으며 모든 사용자에게 같이 보인다.
model AnalysisReport {
  id        String   @id @default(cuid())
  /// 서울 기준 YYYY-MM-DD. 하루에도 여러 리포트를 둘 수 있다.
  date      String
  title     String   @default("")
  body      String   @default("")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date, createdAt])
}

model PhaseDiagnosis {
  id         String  @id @default(cuid())
  date       String  @unique
  autoPhase  String?
  ruleId     Int?
  inputsJson String
  summary    String
}
